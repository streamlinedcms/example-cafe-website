# Settings for staging, loaded by `astro build --mode staging` and by the dev server
# (`npm run dev`). They're public (they end up in the built pages), so this file is
# committed. Every value is required: the build stops if one is missing (see env.schema
# in astro.config.js).
#
# Same Streamlined CMS app and SDK as production, so staging shows the live content.
# Signing in here, or on the dev server, edits the live site.
PUBLIC_SCMS_APP_ID=
PUBLIC_SCMS_SDK_URL=https://cdn.streamlinedcms.com/client-sdk/v1/streamlined-cms.min.js
PUBLIC_SCMS_API_URL=https://api.streamlinedcms.com/v1

# The site's public address, for canonical links, social previews and the sitemap.
# Staging builds also tell search engines not to index the site.
PUBLIC_SITE_URL=https://cafe-staging.streamlinedcms.com
