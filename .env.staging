# Staging's address, for canonical links and social previews. Loaded by
# `astro build --mode staging` and the dev server (`npm run dev`), on top of the shared
# settings in .env.
#
# Staging uses the same Streamlined CMS app as the live site, so signing in here, or on
# the dev server, edits the live site.
PUBLIC_SITE_URL=https://cafe.staging.streamlinedcms.com
