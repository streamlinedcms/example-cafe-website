# Public settings shared by every build: the live site, staging and the dev server all
# use the same Streamlined CMS app. They end up in the built pages, so this file is
# committed. Every value is required: the build stops if one is missing (see env.schema
# in astro.config.js). Secrets never go here; they go in .env.local (see
# .env.local.example).
#
# Trying the site with your own app? Put your App ID here (see the README).
PUBLIC_SCMS_APP_ID=
PUBLIC_SCMS_SDK_URL=https://cdn.streamlinedcms.com/client-sdk/v1/streamlined-cms.min.js
PUBLIC_SCMS_API_URL=https://api.streamlinedcms.com/v1
