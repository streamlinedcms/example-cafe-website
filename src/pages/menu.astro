---
import Layout from "../layouts/Layout.astro";
import MenuSection from "../components/MenuSection.astro";
import SeasonalList from "../components/SeasonalList.astro";

// Starting copy for each section. Once a section has been edited in the CMS, the CMS
// holds its items and changes here no longer show.
const espresso = [
    { name: "Espresso", price: "3.25", description: "A double shot of the house blend." },
    {
        name: "Cortado",
        price: "4.25",
        description: "Espresso cut with an equal part of warm milk.",
    },
    {
        name: "Cappuccino",
        price: "4.75",
        description: "Espresso, steamed milk and a deep cap of foam.",
    },
    {
        name: "Latte",
        price: "5.00",
        description: "Espresso and silky steamed milk. Ask for it iced.",
    },
    { name: "Mocha", price: "5.50", description: "A latte with bittersweet dark chocolate." },
];
const brewed = [
    {
        name: "Drip coffee",
        price: "3.00",
        description: "Whatever came off the roaster this week. Free refills.",
    },
    {
        name: "Pour-over",
        price: "5.25",
        description: "Single origin, brewed by hand. Ask what's on the shelf.",
    },
    {
        name: "Cold brew",
        price: "4.75",
        description: "Steeped for eighteen hours, served over ice.",
    },
];
const tea = [
    {
        name: "Loose-leaf tea",
        price: "3.50",
        description: "Earl Grey, sencha, chamomile or peppermint.",
    },
    {
        name: "Chai latte",
        price: "5.00",
        description: "Spiced black tea simmered in milk, made in-house.",
    },
    {
        name: "Hot chocolate",
        price: "4.25",
        description: "Dark chocolate and steamed milk, with whipped cream.",
    },
];
const bakery = [
    {
        name: "Cardamom bun",
        price: "4.50",
        description: "Our most popular thing, by a long way. Gone by noon.",
    },
    { name: "Butter croissant", price: "3.75", description: "Baked every morning by Priya." },
    { name: "Seasonal scone", price: "3.95", description: "Cranberry and orange this month." },
    {
        name: "Toast with jam",
        price: "4.25",
        description: "Thick-cut country bread with house blackberry jam.",
    },
];
---

<Layout
    title="Menu"
    description="Espresso, pour-overs, tea and fresh pastries at Wrenwick Roast House, with seasonal specials that change through the year."
>
    <main id="main" data-scms-group="page-menu">
        <!-- Page heading, set like the top of a printed menu card -->
        <section class="mx-auto max-w-6xl px-5 pt-12 pb-10 md:pt-20">
            <div class="grid gap-8 md:grid-cols-12 md:items-end">
                <div class="md:col-span-7">
                    <p class="label text-rust" data-scms-text="label">
                        The menu
                    </p>
                    <h1
                        class="mt-4 text-5xl leading-none font-semibold md:text-7xl"
                        data-scms-text="title"
                    >
                        What's on the counter
                    </h1>
                </div>
                <div
                    class="prose-cafe text-ink-soft md:col-span-4 md:col-start-9"
                    data-scms-html="intro"
                >
                    <p>
                        Every coffee here was roasted in the back of the shop. Whole, oat and almond
                        milk at no extra charge.
                    </p>
                </div>
            </div>
        </section>

        <div class="mx-auto max-w-6xl px-5">
            <div class="rule-double"></div>
        </div>

        <!-- Seasonal specials: the same list as the home page -->
        <section class="mx-auto max-w-6xl px-5 py-14">
            <div class="kraft grid gap-8 border border-ink/25 p-6 md:grid-cols-12 md:p-10">
                <div class="md:col-span-4">
                    <p class="label text-rust" data-scms-text="seasonal-label">
                        For a limited time
                    </p>
                    <h2 class="mt-3 text-4xl font-semibold" data-scms-text="seasonal-title">
                        Seasonal specials
                    </h2>
                    <img
                        src="/images/iced-latte.jpg"
                        alt="An iced latte in a tall glass on a wooden table"
                        class="mt-6 hidden aspect-[4/3] w-full object-cover md:block"
                        data-scms-image="seasonal-image"
                    />
                </div>
                <div class="md:col-span-7 md:col-start-6">
                    <SeasonalList />
                </div>
            </div>
        </section>

        <!-- The menu itself, in two columns like a printed card -->
        <section class="mx-auto max-w-6xl px-5 pb-20">
            <div class="grid gap-x-16 gap-y-14 md:grid-cols-2">
                <MenuSection
                    id="menu-espresso"
                    title="Espresso"
                    note="House blend · Brazil & Colombia"
                    items={espresso}
                />
                <div class="space-y-14">
                    <img
                        src="/images/portafilter.jpg"
                        alt="A portafilter of fresh grounds beside a jar of whole beans"
                        class="aspect-[16/10] w-full object-cover"
                        data-scms-image="espresso-image"
                    />
                    <MenuSection
                        id="menu-brewed"
                        title="Brewed"
                        note="Single origins from the shelf"
                        items={brewed}
                    />
                </div>
                <MenuSection
                    id="menu-tea"
                    title="Tea & more"
                    note="For the non-coffee drinkers"
                    items={tea}
                />
                <MenuSection
                    id="menu-bakery"
                    title="From the oven"
                    note="Baked in-house every morning"
                    items={bakery}
                />
            </div>

            <div class="mt-16 grid gap-8 md:grid-cols-12">
                <img
                    src="/images/croissants.jpg"
                    alt="Two butter croissants dusted with flour"
                    class="aspect-[16/9] w-full object-cover md:col-span-7"
                    data-scms-image="bakery-image"
                />
                <div class="md:col-span-4 md:col-start-9 md:self-end">
                    <p class="label text-ink-soft" data-scms-text="beans-label">
                        To take home
                    </p>
                    <div
                        class="prose-cafe mt-3 font-serif text-2xl leading-snug"
                        data-scms-html="beans-note"
                    >
                        <p>
                            Every coffee on the menu is sold by the bag at the counter, ground or
                            whole.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>
