---
// The roaster's round stamp: the shop name set around a circle, with a coffee bean in
// the middle. Decoration only, so it's hidden from screen readers and not editable.
interface Props {
    class?: string;
}
const { class: className = "" } = Astro.props;
const id = `stamp-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 120 120" class={className} aria-hidden="true" focusable="false">
    <defs>
        <path id={id} d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path>
    </defs>
    <circle cx="60" cy="60" r="57" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <circle cx="60" cy="60" r="34" fill="none" stroke="currentColor" stroke-width="1"></circle>
    <text
        font-family="Inter Variable, system-ui, sans-serif"
        font-size="10.5"
        font-weight="600"
        letter-spacing="3.1"
        fill="currentColor"
    >
        <textPath href={`#${id}`}>WRENWICK ROAST HOUSE · EST. 2014 ·</textPath>
    </text>
    <g transform="translate(60 60) rotate(-28)">
        <ellipse cx="0" cy="0" rx="12" ry="17" fill="currentColor"></ellipse>
        <path
            d="M0,-15 C-5,-6 5,6 0,15"
            fill="none"
            stroke="var(--color-paper)"
            stroke-width="2.4"
            stroke-linecap="round"
        ></path>
    </g>
</svg>
