# Cloudflare, only for an emergency manual deploy when GitHub Actions is down (see
# CONTRIBUTING.md). Normal deploys run in GitHub Actions with their own credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The site's public settings (PUBLIC_*: the Streamlined CMS app, SDK and API addresses,
# and the site's address) live in the committed .env.production and .env.staging, not
# here. `astro build` loads .env.production; `astro build --mode staging` and
# `npm run dev` load .env.staging.
