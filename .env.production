# Settings for the live site, loaded by `astro build`. They're public (they end up in
# the built pages), so this file is committed. Every value is required: the build
# stops if one is missing (see env.schema in astro.config.js).
PUBLIC_SCMS_APP_ID=
PUBLIC_SCMS_SDK_URL=https://cdn.streamlinedcms.com/client-sdk/v1/streamlined-cms.min.js
PUBLIC_SCMS_API_URL=https://api.streamlinedcms.com/v1

# The site's public address, for canonical links, social previews and the sitemap
PUBLIC_SITE_URL=https://cafe.streamlinedcms.com
